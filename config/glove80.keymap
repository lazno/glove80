#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>


/* ===== Layer ===== */

#define LAYER_Base    0
#define LAYER_Lower   1
#define LAYER_Magic   2
#define LAYER_Factory 3


/* ===== Tastenpositionen =====
 * LH/RH = linke/rechte Hand
 * C1-C6 = Spalte (C1 innen, C6 aussen)
 * R1-R6 = Reihe (R1 F-Tasten, R6 unterste Reihe)
 * T1-T6 = Daumentasten (T1-T3 obere, T4-T6 untere Reihe)
 */

#define POS_LH_C6R1 0
#define POS_LH_C5R1 1
#define POS_LH_C4R1 2
#define POS_LH_C3R1 3
#define POS_LH_C2R1 4
#define POS_RH_C2R1 5
#define POS_RH_C3R1 6
#define POS_RH_C4R1 7
#define POS_RH_C5R1 8
#define POS_RH_C6R1 9
#define POS_LH_C6R2 10
#define POS_LH_C5R2 11
#define POS_LH_C4R2 12
#define POS_LH_C3R2 13
#define POS_LH_C2R2 14
#define POS_LH_C1R2 15
#define POS_RH_C1R2 16
#define POS_RH_C2R2 17
#define POS_RH_C3R2 18
#define POS_RH_C4R2 19
#define POS_RH_C5R2 20
#define POS_RH_C6R2 21
#define POS_LH_C6R3 22
#define POS_LH_C5R3 23
#define POS_LH_C4R3 24
#define POS_LH_C3R3 25
#define POS_LH_C2R3 26
#define POS_LH_C1R3 27
#define POS_RH_C1R3 28
#define POS_RH_C2R3 29
#define POS_RH_C3R3 30
#define POS_RH_C4R3 31
#define POS_RH_C5R3 32
#define POS_RH_C6R3 33
#define POS_LH_C6R4 34
#define POS_LH_C5R4 35
#define POS_LH_C4R4 36
#define POS_LH_C3R4 37
#define POS_LH_C2R4 38
#define POS_LH_C1R4 39
#define POS_RH_C1R4 40
#define POS_RH_C2R4 41
#define POS_RH_C3R4 42
#define POS_RH_C4R4 43
#define POS_RH_C5R4 44
#define POS_RH_C6R4 45
#define POS_LH_C6R5 46
#define POS_LH_C5R5 47
#define POS_LH_C4R5 48
#define POS_LH_C3R5 49
#define POS_LH_C2R5 50
#define POS_LH_C1R5 51
#define POS_LH_T1 52
#define POS_LH_T2 53
#define POS_LH_T3 54
#define POS_RH_T3 55
#define POS_RH_T2 56
#define POS_RH_T1 57
#define POS_RH_C1R5 58
#define POS_RH_C2R5 59
#define POS_RH_C3R5 60
#define POS_RH_C4R5 61
#define POS_RH_C5R5 62
#define POS_RH_C6R5 63
#define POS_LH_C6R6 64
#define POS_LH_C5R6 65
#define POS_LH_C4R6 66
#define POS_LH_C3R6 67
#define POS_LH_C2R6 68
#define POS_LH_T4 69
#define POS_LH_T5 70
#define POS_LH_T6 71
#define POS_RH_T6 72
#define POS_RH_T5 73
#define POS_RH_T4 74
#define POS_RH_C2R6 75
#define POS_RH_C3R6 76
#define POS_RH_C4R6 77
#define POS_RH_C5R6 78
#define POS_RH_C6R6 79


/ {

    /* ===== Behaviors ===== */

    behaviors {

        /* Lower-Taste: halten = Lower solange gedrueckt, doppelt tippen = Lower bleibt an */
        lower: lower {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo LAYER_Lower>, <&to LAYER_Lower>;
        };

        /* Magic-Taste: halten = Magic-Layer, tippen = Statusanzeige ueber die LEDs
         * Verwendung im Keymap: &magic LAYER_Magic RGB_STATUS
         */
        magic: magic {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug>;
        };

        /* Bluetooth-Profile: einmal tippen = auswaehlen, zweimal tippen = Verbindung trennen */
        bt_0: bt_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_0>, <&bt BT_DISC 0>;
        };
        bt_1: bt_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_1>, <&bt BT_DISC 1>;
        };
        bt_2: bt_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_2>, <&bt BT_DISC 2>;
        };
        bt_3: bt_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_3>, <&bt BT_DISC 3>;
        };
    };


    /* ===== Macros ===== */

    macros {

        /* Ausgabe auf Bluetooth stellen (sonst gewinnt USB, wenn ein Kabel steckt)
         * und dann das Profil auswaehlen
         */
        bt_select_0: bt_select_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;
        };
        bt_select_1: bt_select_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;
        };
        bt_select_2: bt_select_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;
        };
        bt_select_3: bt_select_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;
        };
    };


    /* ===== Keymap =====
     * Pro Reihe: erst linke Hand, dann rechte Hand.
     * Reihe 5 und 6 enthalten zusaetzlich die Daumentasten (je 3 links, 3 rechts).
     * Die Reihenfolge der Layer muss zu den LAYER_*-Nummern oben passen.
     */

    keymap {
        compatible = "zmk,keymap";

        /* ----- 0: Base ----- */
        layer_Base {
            bindings = <
                // Reihe 1
                /* links     */ &kp F1      &kp F2      &kp F3      &kp F4      &kp F5
                /* rechts    */ &kp F6      &kp F7      &kp F8      &kp F9      &kp F10

                // Reihe 2
                /* links     */ &kp EQUAL   &kp N1      &kp N2      &kp N3      &kp N4      &kp N5
                /* rechts    */ &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp MINUS

                // Reihe 3
                /* links     */ &kp TAB     &kp Q       &kp W       &kp E       &kp R       &kp T
                /* rechts    */ &kp Y       &kp U       &kp I       &kp O       &kp P       &kp BSLH

                // Reihe 4
                /* links     */ &kp ESC     &kp A       &kp S       &kp D       &kp F       &kp G
                /* rechts    */ &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp SQT

                // Reihe 5 + obere Daumentasten
                /* links     */ &kp GRAVE   &kp Z       &kp X       &kp C       &kp V       &kp B
                /* Daumen L  */ &kp LSHFT   &kp LGUI    &lower
                /* Daumen R  */ &kp LCTRL   &kp RGUI    &kp RSHFT
                /* rechts    */ &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp PG_UP

                // Reihe 6 + untere Daumentasten
                /* links     */ &magic LAYER_Magic RGB_STATUS       &kp HOME    &kp END     &kp LEFT    &kp RIGHT
                /* Daumen L  */ &kp BSPC    &kp DEL     &kp LALT
                /* Daumen R  */ &kp RALT    &kp RET     &kp SPACE
                /* rechts    */ &kp UP      &kp DOWN    &kp LBKT    &kp RBKT    &kp PG_DN
            >;
        };

        /* ----- 1: Lower (Medien, Pfeile, Nummernblock) ----- */
        layer_Lower {
            bindings = <
                // Reihe 1
                /* links     */ &kp C_BRI_DN  &kp C_BRI_UP  &kp C_PREV    &kp C_NEXT    &kp C_PP
                /* rechts    */ &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP  &none         &kp PAUSE_BREAK

                // Reihe 2
                /* links     */ &trans        &none         &none         &none         &none         &kp HOME
                /* rechts    */ &kp LPAR      &kp KP_NUM    &kp KP_EQUAL  &kp KP_SLASH  &kp KP_MULTIPLY  &kp PSCRN

                // Reihe 3
                /* links     */ &trans        &none         &none         &kp UP        &none         &kp END
                /* rechts    */ &kp RPAR      &kp KP_N7     &kp KP_N8     &kp KP_N9     &kp KP_MINUS  &kp SLCK

                // Reihe 4
                /* links     */ &trans        &none         &kp LEFT      &kp DOWN      &kp RIGHT     &kp PG_UP
                /* rechts    */ &kp PRCNT     &kp KP_N4     &kp KP_N5     &kp KP_N6     &kp KP_PLUS   &none

                // Reihe 5 + obere Daumentasten
                /* links     */ &trans        &kp K_APP     &none         &kp F11       &kp F12       &kp PG_DN
                /* Daumen L  */ &trans        &trans        &to LAYER_Base
                /* Daumen R  */ &trans        &trans        &trans
                /* rechts    */ &kp COMMA     &kp KP_N1     &kp KP_N2     &kp KP_N3     &kp KP_ENTER  &trans

                // Reihe 6 + untere Daumentasten
                /* links     */ &magic LAYER_Magic RGB_STATUS  &kp CAPS      &kp INS       &kp F11       &kp F12
                /* Daumen L  */ &trans        &trans        &trans
                /* Daumen R  */ &trans        &trans        &trans
                /* rechts    */ &kp KP_N0     &kp KP_N0     &kp KP_DOT    &kp KP_ENTER  &trans
            >;
        };

        /* ----- 2: Magic (Bluetooth, RGB, Bootloader) ----- */
        layer_Magic {
            bindings = <
                // Reihe 1
                /* links     */ &bt BT_CLR       &none            &none            &none            &none
                /* rechts    */ &none            &none            &none            &none            &bt BT_CLR_ALL

                // Reihe 2
                /* links     */ &none            &none            &none            &none            &none            &none
                /* rechts    */ &none            &none            &none            &none            &none            &none

                // Reihe 3
                /* links     */ &none            &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG
                /* rechts    */ &none            &none            &none            &none            &none            &none

                // Reihe 4
                /* links     */ &bootloader      &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF
                /* rechts    */ &none            &none            &none            &none            &none            &bootloader

                // Reihe 5 + obere Daumentasten
                /* links     */ &sys_reset       &none            &none            &none            &none            &none
                /* Daumen L  */ &bt_2            &bt_3            &none
                /* Daumen R  */ &none            &none            &none
                /* rechts    */ &none            &none            &none            &none            &none            &sys_reset

                // Reihe 6 + untere Daumentasten
                /* links     */ &none            &none            &none            &none            &none
                /* Daumen L  */ &bt_0            &bt_1            &out OUT_USB
                /* Daumen R  */ &none            &none            &none
                /* rechts    */ &none            &none            &none            &none            &to LAYER_Factory
            >;
        };

        /* ----- 3: Factory (Tastentest: jede Taste gibt eine Ziffer aus) ----- */
        layer_Factory {
            bindings = <
                // Reihe 1
                /* links     */ &kp N0  &kp N6  &kp N2  &kp N8  &kp N4
                /* rechts    */ &kp N4  &kp N8  &kp N2  &kp N6  &kp N0

                // Reihe 2
                /* links     */ &kp N1  &kp N7  &kp N3  &kp N9  &kp N5  &kp N0
                /* rechts    */ &kp N0  &kp N5  &kp N9  &kp N3  &kp N7  &kp N1

                // Reihe 3
                /* links     */ &kp N2  &kp N8  &kp N4  &kp N0  &kp N6  &kp N1
                /* rechts    */ &kp N1  &kp N6  &kp N0  &kp N4  &kp N8  &kp N2

                // Reihe 4
                /* links     */ &kp N3  &kp N9  &kp N5  &kp N1  &kp N7  &kp N2
                /* rechts    */ &kp N2  &kp N7  &kp N1  &kp N5  &kp N9  &kp N3

                // Reihe 5 + obere Daumentasten
                /* links     */ &kp N4  &kp N0  &kp N6  &kp N2  &kp N8  &kp N3
                /* Daumen L  */ &kp N4  &kp N5  &kp N6
                /* Daumen R  */ &kp N6  &kp N5  &kp N4
                /* rechts    */ &kp N3  &kp N8  &kp N2  &kp N6  &kp N0  &kp N4

                // Reihe 6 + untere Daumentasten
                /* links     */ &kp N5  &kp N1  &kp N7  &kp N3  &kp N9
                /* Daumen L  */ &kp N7  &kp N8  &kp N9
                /* Daumen R  */ &kp N9  &kp N8  &kp N7
                /* rechts    */ &kp N9  &kp N3  &kp N7  &kp N1  &kp N5
            >;
        };
    };
};
